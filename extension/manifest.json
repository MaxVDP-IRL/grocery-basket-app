{
  "manifest_version": 3,
  "name": "Basket",
  "version": "0.1.0",
  "description": "Plan your meals and fill your grocery basket in one click.",
  "permissions": ["storage", "cookies", "tabs"],
  "host_permissions": ["https://barbora.ee/*"],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Basket",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["resolver.html", "resolver.js", "planner.html", "planner.js", "planner.css", "recipes.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://barbora.ee/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
